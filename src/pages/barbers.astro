---
// /barbers/ — the barber(s): portrait, specialty, bio, Instagram and a
// personal Book link, then recent work. Built for 1–4 barbers.
import { Picture } from "astro:assets";
import Base from "../layouts/Base.astro";
import { SITE } from "../config/site";
import { fill } from "../lib/format";
import { photo } from "../lib/media";
import PageIntro from "../components/PageIntro.astro";
import BookLink from "../components/BookLink.astro";
import CrossLinks from "../components/CrossLinks.astro";
import Icon from "../components/Icon.astro";
import Todo from "../components/Todo.astro";
import Gallery from "../components/sections/Gallery.astro";
import CtaBanner from "../components/sections/CtaBanner.astro";

const { pages, inner, barbers, ui } = SITE;
const crumbs = [
  { name: inner.home, path: "/" },
  { name: inner.barbers.h1, path: "/barbers/" },
];
---

<Base title={pages.barbers.title} description={pages.barbers.description} breadcrumbs={crumbs}>
  <PageIntro title={inner.barbers.h1} intro={inner.barbers.intro} crumbs={crumbs} />

  {
    barbers.items.map((b, i) => (
      <section class:list={["section", "barber", { "section--alt": i % 2 === 1 }]} aria-label={b.name ?? b.role}>
        <div class="container barber-grid">
          <Picture
            src={photo(b.photo)}
            alt={b.photoAlt}
            formats={["avif", "webp"]}
            widths={[360, 540, 720]}
            sizes="(min-width: 48rem) 24rem, 100vw"
            quality={60}
            loading={i === 0 ? "eager" : "lazy"}
            decoding="async"
            class="portrait"
          />
          <div>
            <h2>{b.name ?? <Todo label="barber name" />}</h2>
            <p class="role">{b.role}</p>
            <p class="specialty">{b.specialty ?? <Todo label="specialty" />}</p>
            <h3>{inner.barbers.bioTitle}</h3>
            {b.bio ? <p>{b.bio}</p> : <Todo block label="bio: 2–3 sentences in the barber's own words" />}
            <div class="actions">
              <BookLink
                href={b.bookingUrl}
                label={b.name ? fill(ui.bookWith, { name: b.name.split(" ")[0] ?? b.name }) : ui.bookNow}
              />
              {b.instagram ? (
                <a class="text-link" href={b.instagram} rel="noopener me">
                  <Icon name="instagram" size={20} />
                  Instagram
                </a>
              ) : (
                <Todo label="barber Instagram" />
              )}
            </div>
          </div>
        </div>
      </section>
    ))
  }

  <Gallery />
  <CrossLinks current="barbers" />
  <CtaBanner />
</Base>

<style>
  .barber-grid {
    display: grid;
    gap: var(--space-4);
    container-type: inline-size;
  }

  @media (min-width: 48rem) {
    .barber-grid {
      grid-template-columns: 24rem 1fr;
      align-items: start;
      gap: var(--space-5);
    }
  }

  .barber-grid :global(.portrait) {
    inline-size: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius);
    background: var(--felt-raised);
  }

  .role {
    font-family: var(--font-board);
    font-weight: 600;
    font-size: 1.125rem;
    letter-spacing: var(--tracking-board);
    text-transform: uppercase;
    color: var(--gold-ink);
    margin: 0.35rem 0 var(--space-1);
  }

  .specialty {
    color: var(--ink-muted);
    font-size: var(--text-lg);
  }

  h2 {
    margin-block-end: 0;
  }

  h3 {
    margin-block: var(--space-3) var(--space-1);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-3);
    margin-block-start: var(--space-3);
  }
</style>
