---
// /privacy/ — plain-language, California-aware (CCPA/CPRA) privacy policy.
// Written for what this site actually does: no forms, no accounts, no
// analytics, no ad trackers, no cookies set by the site itself.
// Have the owner (or their advisor) review it before launch; it is not legal advice.
import Base from "../layouts/Base.astro";
import { SITE } from "../config/site";
import PageIntro from "../components/PageIntro.astro";
import Address from "../components/Address.astro";
import Todo from "../components/Todo.astro";

const { pages, inner, business, name } = SITE;
const crumbs = [
  { name: inner.home, path: "/" },
  { name: inner.privacy.h1, path: "/privacy/" },
];
// TODO: set to the date the owner approves this policy.
const effective: string | null = null;
---

<Base title={pages.privacy.title} description={pages.privacy.description} breadcrumbs={crumbs}>
  <PageIntro title={inner.privacy.h1} crumbs={crumbs} />

  <article class="section">
    <div class="container prose">
      <p class="effective">Effective date: {effective ?? <Todo label="effective date" />}</p>

      <h2>The short version</h2>
      <p>
        {name}'s website does not ask for your name, email or phone number, does not use analytics or advertising
        trackers, and does not set cookies of its own. We do not sell or share your personal information.
      </p>

      <h2>What the website collects</h2>
      <p>
        Like any website, the server that delivers these pages receives basic technical information when you visit, such
        as your IP address, browser type and the page requested. Our hosting provider (<Todo label="hosting provider, e.g. Cloudflare or Netlify" />)
        keeps this briefly in server logs for security and to keep the site running. We don't use it to identify you.
      </p>

      <h2>Booking, calls and maps</h2>
      <p>
        When you tap <strong>Book</strong>, you leave this site for our booking provider
        (<Todo label="booking provider name" />). Anything you enter there, such as your name, phone number and
        appointment details, is collected by that provider under its own privacy policy, and shared with us so we can
        hold your appointment.
      </p>
      <p>
        The map on this site only loads Google Maps if you choose <strong>Show map</strong>. Google may then set
        cookies and collect information under Google's privacy policy. Tapping <strong>Directions</strong> opens Google
        Maps directly. Calling us uses your phone carrier; we see your number like any business would.
      </p>

      <h2>Your California privacy rights</h2>
      <p>
        If you live in California, the California Consumer Privacy Act (as amended by the CPRA) gives you the right
        to know what personal information a business has about you, to ask for it to be deleted or corrected, to opt
        out of its sale or sharing, and not to be treated differently for using these rights.
      </p>
      <p>
        This website itself does not collect personal information that identifies you, and we do not sell or share
        personal information for cross-context advertising. For information we hold from your bookings or visits, you
        can contact us using the details below and we will respond as the law requires.
      </p>

      <h2>Children</h2>
      <p>
        The website is not directed at children and does not knowingly collect information from them. Appointments
        for children should be made by a parent or guardian.
      </p>

      <h2>Changes</h2>
      <p>If we change how the website handles information, we will update this page and its effective date.</p>

      <h2>Contact</h2>
      <Address />
      <p>
        {business.email ? <a href={`mailto:${business.email}`}>{business.email}</a> : <Todo label="contact email" />}
        <br />
        {
          business.phone ? (
            <a href={`tel:${business.phone}`}>{business.phoneDisplay ?? business.phone}</a>
          ) : (
            <Todo label="phone" />
          )
        }
      </p>
    </div>
  </article>
</Base>

<style>
  .prose {
    max-inline-size: calc(var(--prose-width) + 2 * var(--gutter));
  }

  .prose h2 {
    font-size: var(--text-h3);
    margin-block: var(--space-4) var(--space-1);
  }

  .effective {
    color: var(--ink-muted);
  }
</style>
