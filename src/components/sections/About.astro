---
// About: the shop story, 2–3 short paragraphs written by/for this shop.
import { SITE } from "../../config/site";
import Todo from "../Todo.astro";

const { about } = SITE;
---

<section id="about" class="section" aria-labelledby="about-title">
  <div class="container about">
    <h2 id="about-title">{about.title}</h2>
    <div class="about-body">
      {
        about.paragraphs ? (
          about.paragraphs.map((p) => <p>{p}</p>)
        ) : (
          <Todo block label="shop story: 2–3 short paragraphs (who, since when, what makes the chair different)" />
        )
      }
    </div>
  </div>
</section>

<style>
  .about-body {
    font-size: var(--text-lg);
  }

  @media (min-width: 64rem) {
    .about {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
      gap: var(--space-5);
      align-items: start;
    }
  }
</style>
