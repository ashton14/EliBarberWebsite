---
// Services: every item on the letterboard, with Book right at the price decision.
import { SITE } from "../../config/site";
import BookLink from "../BookLink.astro";
import ServiceBoard from "../ServiceBoard.astro";

const { services } = SITE;
---

<section id="services" class="section services" aria-labelledby="services-title">
  <div class="container">
    <h2 id="services-title">{services.title}</h2>
    <p class="section-intro">{services.intro}</p>
    <div class="services-layout">
      <ServiceBoard items={services.items} />
      <div class="services-actions">
        <BookLink />
      </div>
    </div>
  </div>
</section>

<style>
  .services-layout {
    display: grid;
    gap: var(--space-3);
  }

  .services-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-3);
  }

  /* A real letterboard is narrow: cap it so the eye doesn't travel 700px
     from a name to its price. The actions sit right under it, left-aligned. */
  .services-layout > :global(*) {
    max-inline-size: 46rem;
  }
</style>
