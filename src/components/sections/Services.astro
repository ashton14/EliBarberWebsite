---
// Home page services: the six most popular, on the letterboard, with Book
// right at the price decision and a link to the full menu on /services/.
import { SITE } from "../../config/site";
import BookLink from "../BookLink.astro";
import Icon from "../Icon.astro";
import ServiceBoard from "../ServiceBoard.astro";

const { services, ui } = SITE;
const marked = services.items.filter((s) => s.popular);
if (marked.length > 6) {
  console.warn(
    `[site.ts] ${marked.length} services are marked popular; the home page shows the first 6. The rest appear on /services/.`,
  );
}
const popular = marked.slice(0, 6);
---

<section id="services" class="section services" aria-labelledby="services-title">
  <div class="container">
    <h2 id="services-title">{services.title}</h2>
    <p class="section-intro">{services.intro}</p>
    <div class="services-layout">
      <ServiceBoard items={popular} />
      <div class="services-actions">
        <BookLink />
        <a class="text-link" href="/services/">
          {ui.fullMenu}
          <Icon name="arrow" size={20} />
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .services-layout {
    display: grid;
    gap: var(--space-3);
  }

  .services-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-3);
  }

  /* A real letterboard is narrow: cap it so the eye doesn't travel 700px
     from a name to its price. The actions sit right under it, left-aligned. */
  .services-layout > :global(*) {
    max-inline-size: 46rem;
  }
</style>
