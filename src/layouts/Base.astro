---
// Base layout: the HTML skeleton shared by every page.
import "../styles/global.css";
import { SITE } from "../config/site";
import Seo from "../components/Seo.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ActionBar from "../components/ActionBar.astro";
import { pageGraph, type Crumb } from "../lib/schema";

// Self-hosted fonts (Fontsource files, latin subset). ?url gives the hashed
// asset URL, used both by @font-face and by the single preload below.
import boardFont from "@fontsource/barlow-condensed/files/barlow-condensed-latin-600-normal.woff2?url";
import bodyFont from "@fontsource/atkinson-hyperlegible/files/atkinson-hyperlegible-latin-400-normal.woff2?url";
import bodyFontBold from "@fontsource/atkinson-hyperlegible/files/atkinson-hyperlegible-latin-700-normal.woff2?url";

interface Props {
  title: string;
  description: string;
  /** Absolute or root-relative path of the 1200×630 share image */
  ogImage?: string;
  noindex?: boolean;
  /** Inner pages: breadcrumb trail for the BreadcrumbList schema */
  breadcrumbs?: Crumb[];
  /** Home page: include the FAQPage schema */
  withFaq?: boolean;
}

const { title, description, ogImage = "/og-image.jpg", noindex = false, breadcrumbs, withFaq = false } = Astro.props;

// One connected JSON-LD @graph per indexable page, generated from site.ts.
const jsonLd = noindex
  ? null
  : pageGraph({ path: Astro.url.pathname, title, description, breadcrumbs, withFaq });

const latin =
  "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD";

const fontFaces = `
@font-face{font-family:"Barlow Condensed";font-style:normal;font-weight:600;font-display:swap;src:url(${boardFont}) format("woff2");unicode-range:${latin}}
@font-face{font-family:"Atkinson Hyperlegible";font-style:normal;font-weight:400;font-display:swap;src:url(${bodyFont}) format("woff2");unicode-range:${latin}}
@font-face{font-family:"Atkinson Hyperlegible";font-style:normal;font-weight:700;font-display:swap;src:url(${bodyFontBold}) format("woff2");unicode-range:${latin}}
`;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#141312" />
    <link rel="preload" href={boardFont} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontFaces}></style>
    <slot name="head" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Seo title={title} description={description} image={ogImage} noindex={noindex} />
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a href="#content" class="skip-link">{SITE.ui.skipToContent}</a>
    <Header />
    <main id="content">
      <slot />
    </main>
    <Footer />
    <ActionBar />
  </body>
</html>
