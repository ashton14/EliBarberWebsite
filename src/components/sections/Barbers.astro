---
// Home page barber row. Built for 1–4 barbers; with one barber it becomes a
// single portrait + name + specialty, linking to /barbers/ for the full bio.
import { Picture } from "astro:assets";
import { SITE } from "../../config/site";
import { fill } from "../../lib/format";
import { photo } from "../../lib/media";
import BookLink from "../BookLink.astro";
import Icon from "../Icon.astro";
import Todo from "../Todo.astro";

const { barbers, ui } = SITE;
const solo = barbers.items.length === 1;
---

<section id="barber" class="section" aria-labelledby="barber-title">
  <div class="container">
    <h2 id="barber-title">{barbers.title}</h2>
    <ul class:list={["barber-list", { solo }]}>
      {
        barbers.items.map((b) => (
          <li class="barber">
            <Picture
              src={photo(b.photo)}
              alt={b.photoAlt}
              formats={["avif", "webp"]}
              widths={[320, 480, 640]}
              sizes={solo ? "(min-width: 48rem) 20rem, 100vw" : "(min-width: 48rem) 16rem, 50vw"}
              quality={60}
              loading="lazy"
              decoding="async"
              class="barber-photo"
            />
            <div class="barber-text">
              <h3>{b.name ?? <Todo label="barber name" />}</h3>
              <p class="barber-role">{b.role}</p>
              <p class="barber-specialty">{b.specialty ?? <Todo label="specialty" />}</p>
              <div class="barber-actions">
                <BookLink
                  href={b.bookingUrl}
                  label={b.name ? fill(ui.bookWith, { name: b.name.split(" ")[0] ?? b.name }) : ui.bookNow}
                />
                <a class="text-link" href="/barbers/">
                  {b.name ? fill(ui.meetNamed, { name: b.name.split(" ")[0] ?? b.name }) : ui.meetBarber}
                  <Icon name="arrow" size={20} />
                </a>
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .barber-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: var(--space-4);
  }

  .barber {
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }

  .barber :global(.barber-photo) {
    inline-size: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius);
    background: var(--felt-raised);
  }

  .barber-role {
    font-family: var(--font-board);
    font-weight: 600;
    font-size: 1.125rem;
    letter-spacing: var(--tracking-board);
    text-transform: uppercase;
    color: var(--gold-ink);
    margin: 0.35rem 0 var(--space-1);
  }

  .barber-specialty {
    color: var(--ink-muted);
  }

  .barber-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-3);
    margin-block-start: var(--space-2);
  }

  /* One barber: portrait beside the text once the row has room for it */
  .barber-list.solo {
    container-type: inline-size;
  }

  @container (min-width: 44rem) {
    .barber {
      grid-template-columns: 20rem 1fr;
      align-items: center;
      gap: var(--space-5);
    }
  }
</style>
