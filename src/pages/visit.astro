---
// /visit/ — hours, address (exactly as on Google), map, directions, parking
// and the areas served. Nearby towns are listed here, NOT given their own
// thin doorway pages.
import Base from "../layouts/Base.astro";
import { SITE } from "../config/site";
import PageIntro from "../components/PageIntro.astro";
import CrossLinks from "../components/CrossLinks.astro";
import Todo from "../components/Todo.astro";
import PracticalInfo from "../components/sections/PracticalInfo.astro";
import CtaBanner from "../components/sections/CtaBanner.astro";

const { pages, inner, business } = SITE;
const crumbs = [
  { name: inner.home, path: "/" },
  { name: inner.visit.h1, path: "/visit/" },
];
---

<Base title={pages.visit.title} description={pages.visit.description} breadcrumbs={crumbs}>
  <PageIntro title={inner.visit.h1} intro={inner.visit.intro} crumbs={crumbs} />

  <PracticalInfo showVisitLink={false} areasIntro={inner.visit.areasIntro} title={inner.visit.infoTitle} />

  <section class="section section--alt" aria-labelledby="getting-here">
    <div class="container getting-here">
      <h2 id="getting-here">{inner.visit.gettingHereTitle}</h2>
      <div class="notes">
        <div>
          <h3>{inner.visit.parkingTitle}</h3>
          {business.parking ? <p>{business.parking}</p> : <Todo block label="parking, landmarks and how to find the door" />}
        </div>
        <div>
          <h3>{inner.visit.paymentTitle}</h3>
          <p>{business.payment ? business.payment.join(", ") : <Todo label="payment methods" />}</p>
        </div>
      </div>
    </div>
  </section>

  <CrossLinks current="visit" />
  <CtaBanner />
</Base>

<style>
  .notes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-4);
  }

  h3 {
    margin-block-end: var(--space-1);
  }
</style>
