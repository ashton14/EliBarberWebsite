---
// Gallery: 6–9 photos of real cuts, lazy-loaded, AVIF/WebP, explicit sizes.
// Alt text describes the cut and the place (see site.ts → gallery).
import { Picture } from "astro:assets";
import { SITE } from "../../config/site";
import { photo } from "../../lib/media";

const { gallery } = SITE;
---

<section id="gallery" class="section section--alt" aria-labelledby="gallery-title">
  <div class="container">
    <h2 id="gallery-title">{gallery.title}</h2>
    <p class="section-intro">{gallery.intro}</p>
    <ul class="gallery-grid">
      {
        gallery.photos.map((p) => (
          <li>
            <Picture
              src={photo(p.photo)}
              alt={p.alt}
              formats={["avif", "webp"]}
              widths={[320, 480, 640, 800]}
              sizes="(min-width: 64rem) 23rem, (min-width: 40rem) 33vw, 50vw"
              quality={60}
              loading="lazy"
              decoding="async"
            />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .gallery-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(0.5rem, 0.3rem + 1vw, 1rem);
  }

  @media (min-width: 48rem) {
    .gallery-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .gallery-grid li {
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--felt-raised);
  }

  .gallery-grid :global(img) {
    inline-size: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  /* The one delight: on hover, a slow push-in, like leaning closer to the
     mirror to check the fade. Mouse/trackpad only; off for reduced motion. */
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .gallery-grid :global(img) {
      transition:
        transform 900ms var(--ease-out),
        filter 900ms var(--ease-out);
    }

    .gallery-grid li:hover :global(img) {
      transform: scale(1.06);
      filter: contrast(1.06) saturate(1.05);
    }
  }
</style>
