---
// FAQ with native <details>: accessible, zero JavaScript.
// The FAQPage JSON-LD is generated from the same items (answered ones only),
// so the visible text and the schema always match.
import { SITE } from "../../config/site";
import Todo from "../Todo.astro";

const { faq } = SITE;
---

<section id="faq" class="section section--alt" aria-labelledby="faq-title">
  <div class="container faq">
    <h2 id="faq-title">{faq.title}</h2>
    <div class="faq-list">
      {
        faq.items.map((item) => (
          <details>
            <summary>
              <span>{item.question}</span>
              <svg class="chev" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M5 12h14M12 5v14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
              </svg>
            </summary>
            <div class="answer">{item.answer ? <p>{item.answer}</p> : <Todo block label="answer" />}</div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-list {
    border-block-start: 1px solid var(--paper-line);
    max-inline-size: 50rem;
  }

  details {
    border-block-end: 1px solid var(--paper-line);
  }

  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-2);
    min-block-size: var(--tap);
    padding-block: var(--space-2);
    cursor: pointer;
    list-style: none;
    font-weight: 700;
    font-size: var(--text-lg);
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover {
    color: var(--gold-ink);
  }

  .chev {
    flex: none;
    transition: transform var(--dur) var(--ease-out);
  }

  details[open] .chev {
    transform: rotate(45deg);
  }

  .answer {
    padding-block-end: var(--space-3);
    color: var(--ink-muted);
  }

  .answer p {
    margin: 0;
  }

  @media (min-width: 64rem) {
    .faq {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
      gap: var(--space-5);
      align-items: start;
    }
  }
</style>
