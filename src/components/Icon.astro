---
// Inline SVG icons: one consistent 1.75px stroke on a 24px grid, inheriting
// currentColor. Decorative by default (aria-hidden); the surrounding link or
// button carries the accessible name.
interface Props {
  name: "calendar" | "phone" | "pin" | "star" | "arrow" | "instagram" | "tiktok" | "facebook" | "yelp" | "clock" | "map" | "door";
  size?: number;
  class?: string;
}

const { name, size = 20, class: className } = Astro.props;

const PATHS: Record<Props["name"], string> = {
  calendar: `<rect x="3.5" y="5" width="17" height="15.5" rx="1.5"/><path d="M3.5 9.5h17M8 3v4M16 3v4"/><path d="M8 13.5h2.5M13.5 13.5H16M8 17h2.5"/>`,
  phone: `<path d="M6.6 3.5h2.6l1.6 4.2-2.1 1.4a11 11 0 0 0 5.6 5.6l1.4-2.1 4.2 1.6v2.6a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.6 5.7a2 2 0 0 1 2-2.2z"/>`,
  pin: `<path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11z"/><circle cx="12" cy="10" r="2.4"/>`,
  star: `<path d="m12 3.3 2.6 5.5 6 .8-4.4 4.1 1.1 5.9L12 16.8l-5.3 2.8 1.1-5.9-4.4-4.1 6-.8z"/>`,
  arrow: `<path d="M4.5 12h15M14 6.5l5.5 5.5-5.5 5.5"/>`,
  instagram: `<rect x="3.5" y="3.5" width="17" height="17" rx="4.5"/><circle cx="12" cy="12" r="3.8"/><circle cx="17.2" cy="6.8" r="0.6" fill="currentColor"/>`,
  tiktok: `<path d="M14 3.5v11.2a3.8 3.8 0 1 1-3.8-3.8"/><path d="M14 3.5a4.8 4.8 0 0 0 5 4.6"/>`,
  facebook: `<path d="M14.5 21v-7.5h2.7l.4-3.2h-3.1V8.4c0-.9.3-1.6 1.6-1.6h1.7V4a21 21 0 0 0-2.5-.1c-2.5 0-4.1 1.5-4.1 4.2v2.3H8.4v3.2h2.8V21"/>`,
  yelp: `<path d="M11 3.6v8.2L5.4 7.6"/><path d="M11 11.8 4.6 13.5M11 11.8l-3.6 6.1M12.8 12.6l6.2-2.4M12.8 13.8l5 4.3"/>`,
  clock: `<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>`,
  door: `<path d="M5.5 20.5V4.5a1 1 0 0 1 1-1h11a1 1 0 0 1 1 1v16"/><path d="M3.5 20.5h17"/><path d="M14.5 12.5v.01"/>`,
  map: `<path d="m3.5 6 5.5-2 6 2 5.5-2v14l-5.5 2-6-2-5.5 2z"/><path d="M9 4v14M15 6v14"/>`,
};
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class={className}
  set:html={PATHS[name]}
/>
