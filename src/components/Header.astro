---
// Sticky header: wordmark, nav and a compact Book button. Zero JavaScript:
// on phones the four nav links sit on their own row under the wordmark
// instead of hiding behind a menu button.
import { SITE } from "../config/site";
import BookLink from "./BookLink.astro";

const path = Astro.url.pathname;
// On the home page every nav link targets a section on the same page, so the
// browser scrolls to it smoothly (see global.css). Elsewhere they link to pages.
const onHome = path === "/";
---

<header class="site-header on-felt">
  <div class="container header-inner">
    <a href="/" class="brand peg">{SITE.name}</a>
    <nav class="nav" aria-label={SITE.ui.primaryNav}>
      <ul>
        {
          SITE.navigation.map((item) => (
            <li>
              <a href={onHome ? item.anchor : item.href} aria-current={path === item.href ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <BookLink label={SITE.ui.book} class="header-book" icon={false} />
  </div>
</header>

<style>
  /* Phones: the header scrolls away and the sticky bottom action bar
     (ActionBar.astro) keeps Book / Call / Directions under the thumb.
     Tablet and up: the header itself is sticky. */
  .site-header {
    position: relative;
    z-index: 50;
    border-block-end: 1px solid var(--felt-line);
  }

  @media (min-width: 48rem) {
    .site-header {
      position: sticky;
      inset-block-start: 0;
    }
  }

  .header-inner {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-areas:
      "brand"
      "nav";
    align-items: center;
    column-gap: var(--space-2);
    padding-block: 0.4rem 0;
  }

  .brand {
    grid-area: brand;
    font-size: 1.5rem;
    line-height: 1;
    text-decoration: none;
    color: var(--peg);
    display: inline-flex;
    align-items: center;
    min-block-size: var(--tap);
  }

  /* Phones: the bottom action bar owns Book, so one gold button per screen */
  .header-inner :global(.header-book) {
    display: none;
    grid-area: book;
    min-block-size: 44px;
    padding: 0.5rem 1rem;
    font-size: 1.125rem;
  }

  .nav {
    grid-area: nav;
    margin-inline: calc(var(--gutter) * -1);
    border-block-start: 1px solid var(--felt-line);
  }

  .nav ul {
    display: flex;
    justify-content: space-between;
    list-style: none;
    margin: 0;
    padding: 0 var(--gutter);
  }

  .nav a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--tap);
    padding-inline: 0.25rem;
    font-family: var(--font-board);
    font-weight: 600;
    font-size: 1.125rem;
    letter-spacing: var(--tracking-board);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--peg-muted);
  }

  .nav a:hover,
  .nav a[aria-current="page"] {
    color: var(--peg);
  }

  .nav a[aria-current="page"] {
    text-decoration: underline;
    text-decoration-color: var(--gold);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.35em;
  }

  @media (min-width: 48rem) {
    .header-inner {
      grid-template-columns: auto 1fr auto;
      grid-template-areas: "brand nav book";
      padding-block: 0.6rem;
    }

    .brand {
      font-size: 1.75rem;
    }

    .header-inner :global(.header-book) {
      display: inline-flex;
    }

    .nav {
      margin: 0;
      border: 0;
    }

    .nav ul {
      justify-content: flex-end;
      gap: var(--space-3);
      padding: 0;
    }
  }
</style>
