---
// Descriptive internal links between the main pages (skips the current one).
import { SITE } from "../config/site";
import Icon from "./Icon.astro";

interface Props {
  current: "services" | "barbers" | "visit";
}

const { current } = Astro.props;
const l = SITE.inner.links;
const links = [
  { key: "services", href: "/services/", label: l.services },
  { key: "barbers", href: "/barbers/", label: l.barbers },
  { key: "visit", href: "/visit/", label: l.visit },
  { key: "reviews", href: "/#reviews", label: l.reviews },
].filter((x) => x.key !== current);
---

<nav class="cross-links container" aria-label={SITE.ui.moreFrom}>
  <ul>
    {
      links.map((x) => (
        <li>
          <a class="text-link" href={x.href}>
            {x.label}
            <Icon name="arrow" size={20} />
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .cross-links {
    padding-block: var(--space-4);
    border-block-start: 1px solid var(--paper-line);
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
  }
</style>
