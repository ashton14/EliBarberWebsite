---
// <head> tags for search and sharing: title, description, canonical, Open
// Graph and Twitter cards. Structured data (JSON-LD) is a separate component.
import { SITE } from "../config/site";
import { absUrl } from "../lib/paths";

interface Props {
  title: string;
  description: string;
  /** Path (inside public/) or absolute URL of a 1200×630 share image */
  image?: string | undefined;
  noindex?: boolean;
}

const { title, description, image, noindex = false } = Astro.props;

// Hard SEO limits: fail the build rather than ship a truncated snippet.
if (title.length > 60) throw new Error(`<title> is ${title.length} chars (max 60): "${title}"`);
if (description.length > 155)
  throw new Error(`Meta description is ${description.length} chars (max 155): "${description}"`);

// Self-referencing canonical, always with a trailing slash (see astro.config)
const canonical = new URL(Astro.url.pathname, Astro.site);
const absoluteImage = image ? (/^https?:/.test(image) ? image : absUrl(image)) : null;
---

<title>{title}</title>
<meta name="description" content={description} />
{!noindex && <link rel="canonical" href={canonical} />}
{noindex && <meta name="robots" content="noindex" />}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={SITE.ogLocale} />
{absoluteImage && <meta property="og:image" content={absoluteImage} />}
{absoluteImage && <meta property="og:image:width" content="1200" />}
{absoluteImage && <meta property="og:image:height" content="630" />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{absoluteImage && <meta name="twitter:image" content={absoluteImage} />}
